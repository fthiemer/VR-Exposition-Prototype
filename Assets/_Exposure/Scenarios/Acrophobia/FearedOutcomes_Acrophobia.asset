  m_Script: {fileID: 11500000, guid: df556b6bffb94ef47afd7c9c0b8f5e44, type: 3}
  m_Name: FearedOutcomes_Acrophobia
  m_EditorClassIdentifier: Exposure.Runtime::Exposure.FearedOutcomeCatalog
  sourceInstrument: "Angelehnt an das Heights Interpretation Questionnaire (HIQ),
    Steinman & Teachman 2011, J Anxiety Disord 25:896-902. Sinngem\xE4ss umformuliert,
    NICHT die Originalitems und keine validierte \xDCbersetzung."
  outcomes:
  - id: fall
    text: Ich werde herunterfallen.
  - id: injury
    text: Ich werde mich verletzen.
  - id: unsafe
    text: Ich bin hier oben nicht sicher.
  - id: panic
    text: Ich gerate in Panik und verliere die Kontrolle.
  - id: endure
    text: Ich werde die Angst nicht aushalten.
  - id: faint
    text: "Ich werde ohnm\xE4chtig."
  - id: freeze
    text: Ich erstarre und komme nicht mehr weg.
  - id: dizzy
    text: Ich werde so schwindelig, dass ich mich nicht halten kann.
